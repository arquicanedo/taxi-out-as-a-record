    given-names: Arquimedes
    orcid: "https://orcid.org/0000-0003-3506-6563"
    affiliation: "Independent Researcher, Princeton, NJ, USA"
repository-code: "https://github.com/arquicanedo/taxi-out-as-a-record"
keywords:
  - taxi-out time
  - airport operational data
  - ADS-B
  - data quality
  - PRC Data Challenge 2026
